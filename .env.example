# ===== 数据库（PostgreSQL，必填）=====
# 生产 / 部署使用 PostgreSQL。推荐 Neon 或 Supabase 免费档。
# Vercel 等 Serverless 平台连接数紧张，建议带 connection_limit（或 Neon 的 pooled 连接串）。
# 示例：
#   Neon:      DATABASE_URL="postgresql://USER:PASS@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&connection_limit=1"
#   Supabase:  DATABASE_URL="postgresql://postgres:PASS@db.xxxx.supabase.co:5432/postgres?connection_limit=1"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?connection_limit=1"

# ===== 第三方数据源 API Key（均可选）=====
# 未配置时，对应类型自动回退到「标注 MOCK DATA」的占位数据。
# 配置后无需改代码，适配器自动切换为真实数据。

# TMDB（电影 / 电视剧 / 综艺 / 纪录片）—— https://www.themoviedb.org/documentation/api
# 注册后获取 v3 API Key。已内置 language=zh-CN，返回中文。
TMDB_API_KEY=""

# RAWG（游戏：手游 / 网游 / 单机）—— https://rawg.io/apidocs
RAWG_API_KEY=""

# Bangumi（动漫）—— https://bgm.tv/dev/app 注册个人应用获取 app_id（可选）。
# 不配置也能用（公开接口免鉴权，但有频率限制）；配置后提额更稳。
BANGUMI_APP_ID=""

# OMDb（IMDb 双评分，影视类）—— https://www.omdbapi.com/apikey.aspx 免费注册（1000 次/日）。
# 配置后在电影/电视剧/综艺/纪录片卡片上叠加「IMDb 评分」；未配置则只显示豆瓣评分。
OMDB_API_KEY=""

# ===== 站点 =====
# 部署后的正式域名，用于 sitemap / SEO / 外链拼接。
# 本地开发可留空或设为 http://localhost:3000
NEXT_PUBLIC_SITE_URL=""

# ===== 部署（Vercel / Cloudflare）=====
# 在平台「环境变量」中填入上述真实值（DATABASE_URL 必填，其余按需）。
# prisma generate 已由 postinstall / build 自动执行，无需手动。
